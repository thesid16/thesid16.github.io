---
import Icon from './Icon.astro';
import { honors, recognition, reviewerCertificate } from '../data/site';
---

<section id="honors" class="section">
  <div class="container">
    <p class="eyebrow" data-num="06">Honors</p>
    <h2 class="section-title reveal">Recognition</h2>

    <div class="honors reveal">
      <div class="honors__media">
        <figure class="honors__figure">
          <img
            src={recognition.image}
            width={recognition.width}
            height={recognition.height}
            alt={recognition.alt}
            loading="lazy"
            decoding="async"
          />
          <figcaption>{recognition.caption}</figcaption>
        </figure>

        <figure class="honors__figure">
          <a href={reviewerCertificate.pdfPath} target="_blank" rel="noopener" aria-label="Open reviewer certificate as PDF">
            <img
              src={reviewerCertificate.image}
              width={reviewerCertificate.width}
              height={reviewerCertificate.height}
              alt={reviewerCertificate.alt}
              loading="lazy"
              decoding="async"
            />
          </a>
          <figcaption>{reviewerCertificate.caption}</figcaption>
          <div class="btn-row">
            <a class="btn btn--ghost" href={reviewerCertificate.pdfPath} download>
              <Icon name="download" size="1.05rem" /> Download certificate
            </a>
          </div>
        </figure>
      </div>

      <ul class="honor-list">
        {
          honors.map((h) => (
            <li class="honor">
              <h3>{h.title}</h3>
              <p class="honor__org">{h.org}</p>
              <p class="honor__detail">{h.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
